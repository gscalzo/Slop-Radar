# Copy to .env (gitignored) and fill in. Used by the evaluation scripts only —
# the extension itself reads its key from browser storage, never from here.
#
#   cp .env.example .env
#   npm run eval

SLOP_RADAR_API_KEY=sk-...

# Optional. Any OpenAI-compatible endpoint.
# SLOP_RADAR_BASE_URL=https://api.openai.com/v1
